    "Tomato___Bacterial_spot": {
      "crop": "Tomato",
      "disease": "Bacterial spot",
      "is_healthy": false,
      "dosage": null,
      "application_method": null,
      "source": null,
      "verification_status": "source_supported_recommendations_added",
      "officer_approval_required": true,
      "medicine_recommendations": [
        {
          "medicine": "Copper oxychloride 50% WP",
          "source": "ICAR–Indian Institute of Vegetable Research (IIVR), Annual Report 2017–18",
          "source_url": "https://icariivr.org.in/wp-content/uploads/2025/11/Annual-Report-2017-2018English.pdf",
          "source_note": "ICAR-IIVR reported field evaluation of Copper oxychloride 50 WP among treatments against bacterial diseases of tomato; bacterial spot (Xanthomonas) was included."
        },
        {
          "medicine": "Copper hydroxide 53.8 DF",
          "source": "ICAR–Indian Institute of Vegetable Research (IIVR), Annual Report 2017–18",
          "source_url": "https://icariivr.org.in/wp-content/uploads/2025/11/Annual-Report-2017-2018English.pdf",
          "source_note": "ICAR-IIVR reported field evaluation of Copper hydroxide 53.8 DF among treatments against bacterial diseases of tomato; bacterial spot (Xanthomonas) was included."
        }
      ],
      "source_status": "verified_source_recommendations_added",
      "advisory": {
        "summary": "Tomato bacterial spot is a bacterial disease. Management should focus on sanitation, reducing leaf wetness and rain-splash spread, and using only officer-approved, label-claimed products.",
        "actions": [
          "Use disease-free seed and healthy transplants.",
          "Remove and dispose of severely infected plant material and crop debris; do not leave infected debris in the field.",
          "Avoid overhead irrigation and minimize water splash between plants.",
          "Avoid handling or working through the crop when foliage is wet to reduce spread.",
          "Maintain field sanitation and monitor the crop regularly for new lesions.",
          "Use chemical treatment only after diagnosis is confirmed and the extension officer verifies the product label and crop-specific recommendation."
        ],
        "warning": "Copper products can cause phytotoxicity on some tomato varieties. Do not apply a product, tank mix, frequency, or dosage unless it is approved for tomato on the current product label and confirmed by the extension officer.",
        "officer_approval_required": true,
        "source": "ICAR–Indian Institute of Vegetable Research (IIVR), Annual Report 2017–18; ICAR IPM guidance",
        "source_url": "https://icariivr.org.in/wp-content/uploads/2025/11/Annual-Report-2017-2018English.pdf",
        "ipm_source_url": "https://www.icar.gov.in/en/integrated-pest-management-sustainable-approach-responsible-pest-management"
      }
    },
